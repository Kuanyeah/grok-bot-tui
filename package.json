{
  "name": "@kuanyeah/pebble-chat",
  "version": "0.1.0",
  "description": "An unofficial Grok Bot UI for your terminal, with image attachments and animated avatars",
  "type": "module",
  "license": "MIT",
  "bin": {
    "grok": "bin/grok.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/grok.js bot",
    "demo": "node bin/grok.js bot --mock",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "node scripts/patch-kitty.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-picture": "2.1.0",
    "react": "^19.2.8",
    "string-width": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuanyeah/pebble-chat.git"
  },
  "files": [
    "bin",
    "src",
    "scripts/patch-kitty.js",
    "licenses",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "fixtures"
  ],
  "overrides": {
    "zod": "^4.6.6"
  }
}
